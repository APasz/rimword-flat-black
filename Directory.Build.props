<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(HOME)/.steam/steam/steamapps/common/RimWorld</RimWorldDir>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(RimWorldDir)/../../workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
    <CopyGameReferences Condition="'$(CopyGameReferences)' == ''">false</CopyGameReferences>
  </PropertyGroup>
</Project>
